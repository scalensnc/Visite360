{
  "name": "panorama-360-viewer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "viewer:build": "vite build --config vite.static.config.ts",
    "viewer:publish": "node --experimental-strip-types scripts/publish-viewer.ts",
    "studio:dev": "vite --config vite.studio.config.ts",
    "studio:build": "vite build --config vite.studio.config.ts",
    "studio:publish": "node --experimental-strip-types scripts/publish-studio.ts",
    "visite:build": "node --experimental-strip-types scripts/build-tour.ts",
    "visite:publish": "node --experimental-strip-types scripts/publish-tour.ts",
    "infra:synth": "cdk synth",
    "infra:deploy": "cdk deploy --all",
    "start": "vinext start",
    "test": "npm run build && npm run viewer:build && npm run studio:build && node --test tests/rendered-html.test.mjs && node --experimental-strip-types --test tests/tour-builder.test.ts tests/api-domain.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern dist-studio --ignore-pattern dist-github --ignore-pattern outputs --ignore-pattern cdk.out --ignore-pattern work --ignore-pattern .next --ignore-pattern .npm-cache --ignore-pattern .pnpm-store",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1107.0",
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/lib-dynamodb": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@types/three": "^0.185.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "aws-cdk": "^2.1135.1",
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.8.1",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
